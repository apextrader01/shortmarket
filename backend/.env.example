# ==============================================================================
# SkandX Backend Environment Variables Template (.env.example)
# Copy this file to backend/.env on your server and fill in real values.
# NEVER commit backend/.env to GitHub.
# ==============================================================================

PORT=5000
NODE_ENV=production

# Core Security & JWT Signing (Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_byte_hex_secret

# Google Gemini 3.8 Flash AI Copilot API Key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Firebase Authentication & Mail Service
FIREBASE_PROJECT_ID=skandx-1020f
FIREBASE_API_KEY=replace_with_your_firebase_web_api_key

# Web Push VAPID Keys (Auto-generated in backend/config/vapid.json if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_PLAN_ID_MONTHLY=plan_monthly_id
RAZORPAY_PLAN_ID_YEARLY=plan_yearly_id

# Optional Gmail SMTP for Transactional HTML OTPs
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-google-app-password
